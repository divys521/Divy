import React,{useEffect,useMemo,useRef,useState} from 'react';
import {createRoot} from 'react-dom/client';
import html2canvas from 'html2canvas';
import {jsPDF} from 'jspdf';
import {FileText,Plus,History,LogOut,Search,Download,Printer,Eye,CheckCircle,LayoutDashboard} from 'lucide-react';
import './styles.css';
const KEY='ess_appointment_letters'; const getRows=()=>JSON.parse(localStorage.getItem(KEY)||'[]'); const saveRows=r=>localStorage.setItem(KEY,JSON.stringify(r));
const init={employeeName:'',employeeId:'',address:'',contactNumber:'',designation:'',dateOfJoining:'',letterDate:new Date().toISOString().slice(0,10),probationPeriod:'3 months',contractPeriod:'2 years',contractAmount:150000,basic:0,hra:0,pf:1800,gratuity:0,earnedLeave:0,accidentalInsurance:0};
const money=n=>Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2}); const date=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}):'';
function calc(f){let basic=+f.basic||0,hra=+f.hra||0,pf=+f.pf||0,g=+f.gratuity||0,e=+f.earnedLeave||0,a=+f.accidentalInsurance||0;return{gross:basic+hra+pf,totalBenefits:g+e+a,ctc:basic+hra+pf+g+e+a}}
function App(){return <Shell/>}

function Shell(){const[page,setPage]=useState('dash');return <div className="app"><aside><div className="brand"><div className="logo sm"><FileText/></div><b>ESS HR</b></div><nav><button className={page==='dash'?'on':''} onClick={()=>setPage('dash')}><LayoutDashboard/>Dashboard</button><button className={page==='new'?'on':''} onClick={()=>setPage('new')}><Plus/>New Appointment Letter</button><button className={page==='hist'?'on':''} onClick={()=>setPage('hist')}><History/>Appointment Letter History</button></nav><div className="sign"><LogOut/>Local System</div></aside><main><header><div><small>HUMAN RESOURCES</small><h2>{page==='dash'?'Dashboard':page==='new'?'New Appointment Letter':'Appointment Letter History'}</h2></div><span>HR Workspace</span></header>{page==='dash'?<Dashboard go={setPage}/>:page==='new'?<Generator done={()=>setPage('hist')}/>:<HistoryPage/>}</main></div>}
function Dashboard({go}){const[rows,setRows]=useState(getRows());useEffect(()=>{setRows(getRows())},[]);return <section className="content"><div className="hero"><div><h3>Appointment Letter Generator</h3><p>Enter employee details once and generate the appointment letter PDF.</p></div><button onClick={()=>go('new')}><Plus/>New Appointment Letter</button></div><div className="stats"><div><small>Total Appointment Letters</small><b>{rows.length}</b></div><div><small>Letters Generated This Month</small><b>{rows.filter(x=>(x.generated_at||'').slice(0,7)===new Date().toISOString().slice(0,7)).length}</b></div><div><small>Drafts</small><b>{rows.filter(x=>x.status==='Draft').length}</b></div></div><section className="panel"><div className="panelhead"><b>Recent Letters</b><button className="link" onClick={()=>go('hist')}>View all</button></div><Table rows={rows.slice(0,5)}/></section></section>}
function Generator({done}){const[f,setF]=useState(init),[preview,setPreview]=useState(false),[busy,setBusy]=useState(false),[err,setErr]=useState(''),[result,setResult]=useState(null),ref=useRef(null),c=useMemo(()=>calc(f),[f]);const set=(k,v)=>setF(x=>({...x,[k]:v}));function validate(){if(!f.employeeName.trim())return'Employee name is required.';if(!f.employeeId.trim())return'Employee ID / Serial Number is required.';if(!f.designation.trim())return'Designation is required.';if(!f.dateOfJoining||!f.letterDate)return'Valid dates are required.';if(f.contactNumber&&!/^[0-9+()\-\s]{7,18}$/.test(f.contactNumber))return'Enter a valid contact number.';for(const k of['contractAmount','basic','hra','pf','gratuity','earnedLeave','accidentalInsurance'])if(+f[k]<0)return'Negative values are not allowed.';return''}async function generate(){let v=validate();if(v){setErr(v);return}setBusy(true);try{const rows=getRows();const month=new Date(f.letterDate).toLocaleString('en-US',{month:'short'}).toUpperCase();const year=new Date(f.letterDate).getFullYear();const num=`ESS/HR/APP/${month}/${year}/${String(rows.length+1).padStart(3,'0')}`;ref.current.querySelectorAll('.lh span:first-child,.annex>div:first-child').forEach(el=>el.textContent=num);const canvas=await html2canvas(ref.current,{scale:2,backgroundColor:'#fff'}),pdf=new jsPDF('p','mm','a4'),w=210,h=canvas.height*210/canvas.width,img=canvas.toDataURL('image/png');for(let y=0;y<h;y+=297){if(y)pdf.addPage();pdf.addImage(img,'PNG',0,-y,w,h)}const dataUrl=pdf.output('datauristring');const row={id:Date.now(),letter_number:num,status:'Generated',generated_at:new Date().toISOString(),employee_records:{...map(f)},file_name:num.replaceAll('/','-')+'-'+f.employeeName.replaceAll(' ','-')+'.pdf',pdf:dataUrl};saveRows([row,...rows]);setResult({number:num,path:dataUrl,fileName:row.file_name});}catch(e){setErr(e.message||'Generation failed.')}finally{setBusy(false)}}