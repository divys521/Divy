import React,{useEffect,useMemo,useRef,useState} from 'react';
import {createRoot} from 'react-dom/client';
import html2canvas from 'html2canvas';
import {jsPDF} from 'jspdf';
import {FileText,Plus,History,LogOut,Search,Download,Printer,Eye,CheckCircle,LayoutDashboard} from 'lucide-react';
import './styles.css';
import {createClient,SupabaseAuthAdapter} from '@neondatabase/neon-js';
const NEON_AUTH_URL='https://ep-morning-meadow-zazsx27q.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth';
const NEON_DATA_API_URL='https://ep-morning-meadow-zazsx27q.apirest.c-2.eu-west-2.aws.neon.tech/neondb/rest/v1';
const supabase=createClient({auth:{adapter:SupabaseAuthAdapter(),url:NEON_AUTH_URL},dataApi:{url:NEON_DATA_API_URL,options:{db:{schema:'ess_hr'}}}});
const db=supabase.schema('ess_hr');
const init={employeeName:'',employeeId:'',address:'',contactNumber:'',designation:'',dateOfJoining:'',letterDate:new Date().toISOString().slice(0,10),probationPeriod:'3 months',contractPeriod:'2 years',contractAmount:150000,basic:0,hra:0,pf:1800,gratuity:0,earnedLeave:0,accidentalInsurance:0};
const money=n=>Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2}); const date=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}):'';
function calc(f){let basic=+f.basic||0,hra=+f.hra||0,pf=+f.pf||0,g=+f.gratuity||0,e=+f.earnedLeave||0,a=+f.accidentalInsurance||0;return{gross:basic+hra+pf,totalBenefits:g+e+a,ctc:basic+hra+pf+g+e+a}}
function App(){const[session,setSession]=useState(null),[loading,setLoading]=useState(true),[authOpen,setAuthOpen]=useState(false);useEffect(()=>{let active=true;supabase.auth.getSession().then(({data})=>{if(active){setSession(data.session);setLoading(false)}});const {data:{subscription}}=supabase.auth.onAuthStateChange((_e,s)=>{setSession(s);if(s)setAuthOpen(false)});return()=>{active=false;subscription.unsubscribe()}},[]);if(loading)return <div className="app-loading">Opening ESS HR Workspace…</div>;return <><Shell session={session} openLogin={()=>setAuthOpen(true)} onSignOut={()=>supabase.auth.signOut()}/>{authOpen&&!session&&<div className="auth-overlay"><Login onSuccess={()=>setAuthOpen(false)} onClose={()=>setAuthOpen(false)}/></div>}</>}
function Login({onSuccess,onClose}){const[email,setEmail]=useState(''),[password,setPassword]=useState(''),[busy,setBusy]=useState(false),[err,setErr]=useState('');async function submit(){setBusy(true);setErr('');const {error}=await supabase.auth.signInWithPassword({email,password});if(error)setErr(error.message);else onSuccess?.();setBusy(false)}return <div className="login-card auth-card"><button className="auth-close" aria-label="Close sign in" onClick={onClose}>×</button><div className="logo"><FileText/></div><h1>Sign in to ESS HR</h1><p>Sign in to access confidential employee records and generate letters.</p><label>HR email<input name="email" type="email" autoComplete="username" value={email} onChange={e=>setEmail(e.target.value)} placeholder="HR email" required/></label><label>Password<input name="password" type="password" autoComplete="current-password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="Password" required/></label><button onClick={submit} disabled={busy}>{busy?'Signing in…':'Sign In'}</button>{err&&<div className="err">{err}</div>}</div>}
function Shell({session,openLogin,onSignOut}){const[page,setPage]=useState('dash');function go(next){if(next!=='dash'&&!session){openLogin();return}setPage(next)}return <div className="app"><aside><div className="brand"><div className="logo sm"><FileText/></div><b>ESS HR</b></div><nav><button className={page==='dash'?'on':''} onClick={()=>go('dash')}><LayoutDashboard/>Dashboard</button><button className={page==='new'?'on':''} onClick={()=>go('new')}><Plus/>New Appointment Letter</button><button className={page==='hist'?'on':''} onClick={()=>go('hist')}><History/>Appointment Letter History</button></nav>{session?<button className="sign" onClick={onSignOut}><LogOut/>Sign Out</button>:<button className="sign" onClick={openLogin}><FileText/>HR Sign In</button>}</aside><main><header><div><small>HUMAN RESOURCES</small><h2>{page==='dash'?'Dashboard':page==='new'?'New Appointment Letter':'Appointment Letter History'}</h2></div><div className="header-right"><span>{session?'Authenticated HR Workspace':'Welcome to ESS HR'}</span>{session?<button className="header-auth" onClick={onSignOut}>Sign Out</button>:<button className="header-auth" onClick={openLogin}>HR Sign In</button>}</div></header>{page==='dash'?<Dashboard go={go} session={session} openLogin={openLogin}/>:page==='new'&&session?<Generator done={()=>setPage('hist')}/>:page==='hist'&&session?<HistoryPage/>:<Dashboard go={go} session={session} openLogin={openLogin}/>}</main></div>}
function Dashboard({go,session,openLogin}){const[rows,setRows]=useState([]),[loading,setLoading]=useState(!!session);useEffect(()=>{let active=true;if(!session){setRows([]);setLoading(false);return()=>{active=false}}setLoading(true);(async()=>{const {data,error}=await db.from('appointment_letters').select('id,letter_number,status,generated_at,employee_records(employee_name,employee_id,designation,date_of_joining,letter_date)').order('generated_at',{ascending:false});if(active){setRows(error?[]:(data||[]));setLoading(false)}})();return()=>{active=false}},[session]);return <section className="content"><div className="hero"><div><h3>Appointment Letter Generator</h3><p>Enter employee details once and generate the appointment letter PDF.</p></div><button onClick={()=>session?go('new'):openLogin()}><Plus/>{session?'New Appointment Letter':'Sign in to get started'}</button></div>{!session&&<div className="auth-notice"><b>HR access required</b><p>The dashboard is available without signing in. Employee records, letter history, database operations and PDF generation remain protected. Sign in with your authorized HR account to continue.</p><button onClick={openLogin}>HR Sign In</button></div>}<div className="stats"><div><small>Total Appointment Letters</small><b>{!session?'—':loading?'…':rows.length}</b></div><div><small>Letters Generated This Month</small><b>{!session?'—':loading?'…':rows.filter(x=>(x.generated_at||'').slice(0,7)===new Date().toISOString().slice(0,7)).length}</b></div><div><small>Drafts</small><b>{!session?'—':loading?'…':rows.filter(x=>x.status==='Draft').length}</b></div></div><section className="panel"><div className="panelhead"><b>Recent Letters</b>{session&&<button className="link" onClick={()=>go('hist')}>View all</button>}</div>{session?<Table rows={rows.slice(0,5)}/>:<div className="empty-protected">Sign in to view recent appointment letters.</div>}</section></section>}
function Generator({done}){const[f,setF]=useState(init),[preview,setPreview]=useState(false),[busy,setBusy]=useState(false),[err,setErr]=useState(''),[result,setResult]=useState(null),ref=useRef(null),c=useMemo(()=>calc(f),[f]);const set=(k,v)=>setF(x=>({...x,[k]:v}));function validate(){if(!f.employeeName.trim())return'Employee name is required.';if(!f.employeeId.trim())return'Employee ID / Serial Number is required.';if(!f.designation.trim())return'Designation is required.';if(!f.dateOfJoining||!f.letterDate)return'Valid dates are required.';if(f.contactNumber&&!/^[0-9+()\-\s]{7,18}$/.test(f.contactNumber))return'Enter a valid contact number.';for(const k of['contractAmount','basic','hra','pf','gratuity','earnedLeave','accidentalInsurance'])if(+f[k]<0)return'Negative values are not allowed.';return''}async function generate(){let v=validate();if(v){setErr(v);return}setBusy(true);setErr("Preparing PDF…");await new Promise(r=>requestAnimationFrame(r));try{const {data:{session}}=await supabase.auth.getSession();const user=session?.user;if(!user)throw new Error("Your session has expired. Please sign in again.");
const {data:num,error:numError}=await db.rpc('next_appointment_letter_number',{p_letter_date:f.letterDate});if(numError)throw numError;ref.current.querySelectorAll(".lh span:first-child,.annex>div:first-child").forEach(el=>el.textContent=num);setErr("Rendering appointment letter…");const canvas=await html2canvas(ref.current,{scale:1,backgroundColor:"#fff",logging:false,useCORS:false,windowWidth:794,windowHeight:ref.current.scrollHeight});setErr("Creating PDF…");const pdf=new jsPDF("p","mm","a4"),pageW=210,pageH=297,imgW=210,imgH=canvas.height*pageW/canvas.width,img=canvas.toDataURL("image/jpeg",0.82);for(let y=0;y<imgH;y+=pageH){if(y)pdf.addPage();pdf.addImage(img,"JPEG",0,-y,imgW,imgH,undefined,"FAST")}const fileName=num.replaceAll("/","-")+"-"+f.employeeName.replaceAll(" ","-")+".pdf";const pdfData=pdf.output("datauristring").split(",")[1];const safeName=fileName.replace(/[^a-zA-Z0-9._-]/g,"-");const storagePath="neon-db/"+safeName;setErr("Saving letter to Neon…");const values=map(f);values.created_by=user.id;values.gross=c.gross;values.total_benefits=c.totalBenefits;values.ctc=c.ctc;const {data:employee,error:employeeError}=await db.from("employee_records").insert(values).select("id").single();if(employeeError)throw employeeError;const {data:letter,error:letterError}=await db.from("appointment_letters").insert({created_by:user.id,employee_record_id:employee.id,letter_number:num,status:"Generated",generated_at:new Date().toISOString()}).select("id").single();if(letterError)throw letterError;const {error:docError}=await db.from("generated_documents").insert({created_by:user.id,appointment_letter_id:letter.id,storage_path:storagePath,file_name:safeName,mime_type:"application/pdf",pdf_base64:pdfData});if(docError)throw docError;setResult({number:num,path:"data:application/pdf;base64,"+pdfData,fileName:safeName});setErr("")}catch(e){setErr(e.message||"Generation failed.")}finally{setBusy(false)}}