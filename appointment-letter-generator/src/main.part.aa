import React,{useEffect,useMemo,useRef,useState} from 'react';
import {createRoot} from 'react-dom/client';
import html2canvas from 'html2canvas';
import {jsPDF} from 'jspdf';
import {FileText,Plus,History,Search,Download,Printer,Eye,CheckCircle,LayoutDashboard} from 'lucide-react';
import './styles.css';
import {createClient} from '@neondatabase/neon-js';
const NEON_DATA_API_URL='https://ep-morning-meadow-zazsx27q.apirest.c-2.eu-west-2.aws.neon.tech/neondb/rest/v1';
const supabase=createClient({dataApi:{url:NEON_DATA_API_URL,options:{db:{schema:'ess_hr'}}}});
const db=supabase.schema('ess_hr');
const init={employeeName:'',employeeId:'',address:'',contactNumber:'',designation:'',dateOfJoining:'',letterDate:new Date().toISOString().slice(0,10),probationPeriod:'3 months',contractPeriod:'2 years',contractAmount:150000,basic:0,hra:0,pf:1800,gratuity:0,earnedLeave:0,accidentalInsurance:0};
const money=n=>Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2}); const date=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}):'';
function calc(f){let basic=+f.basic||0,hra=+f.hra||0,pf=+f.pf||0,g=+f.gratuity||0,e=+f.earnedLeave||0,a=+f.accidentalInsurance||0;return{gross:basic+hra+pf,totalBenefits:g+e+a,ctc:basic+hra+pf+g+e+a}}
function App(){return <Shell/>}
function Shell(){const[page,setPage]=useState('dash');function go(next){setPage(next)}return <div className="app"><aside><div className="brand"><div className="logo sm"><FileText/></div><b>ESS HR</b></div><nav><button className={page==='dash'?'on':''} onClick={()=>go('dash')}><LayoutDashboard/>Dashboard</button><button className={page==='new'?'on':''} onClick={()=>go('new')}><Plus/>New Appointment Letter</button><button className={page==='hist'?'on':''} onClick={()=>go('hist')}><History/>Appointment Letter History</button></nav></aside><main><header><div><small>HUMAN RESOURCES</small><h2>{page==='dash'?'Dashboard':page==='new'?'New Appointment Letter':'Appointment Letter History'}</h2></div><div className="header-right"><span>ESS HR Workspace</span></div></header>{page==='dash'?<Dashboard go={go}/>:page==='new'?<Generator done={()=>setPage('hist')}/>:<HistoryPage/>}</main></div>}
function Dashboard({go}){const[rows,setRows]=useState([]),[loading,setLoading]=useState(true);useEffect(()=>{let active=true;(async()=>{const {data,error}=await db.from('appointment_letters').select('id,letter_number,status,generated_at,employee_records(employee_name,employee_id,designation,date_of_joining,letter_date)').order('generated_at',{ascending:false});if(active){setRows(error?[]:(data||[]));setLoading(false)}})();return()=>{active=false}},[]);return <section className="content"><div className="hero"><div><h3>Appointment Letter Generator</h3><p>Enter employee details once and generate the appointment letter PDF.</p></div><button onClick={()=>go('new')}><Plus/>New Appointment Letter</button></div><div className="stats"><div><small>Total Appointment Letters</small><b>{loading?'…':rows.length}</b></div><div><small>Letters Generated This Month</small><b>{loading?'…':rows.filter(x=>(x.generated_at||'').slice(0,7)===new Date().toISOString().slice(0,7)).length}</b></div><div><small>Drafts</small><b>{loading?'…':rows.filter(x=>x.status==='Draft').length}</b></div></div><section className="panel"><div className="panelhead"><b>Recent Letters</b><button className="link" onClick={()=>go('hist')}>View all</button></div><Table rows={rows.slice(0,5)}/></section></section>}
function Generator({done}){const[f,setF]=useState(init),[preview,setPreview]=useState(false),[busy,setBusy]=useState(false),[err,setErr]=useState(''),[result,setResult]=useState(null),ref=useRef(null),c=useMemo(()=>calc(f),[f]);const set=(k,v)=>setF(x=>({...x,[k]:v}));function validate(){if(!f.employeeName.trim())return'Employee name is required.';if(!f.employeeId.trim())return'Employee ID / Serial Number is required.';if(!f.designation.trim())return'Designation is required.';if(!f.dateOfJoining||!f.letterDate)return'Valid dates are required.';if(f.contactNumber&&!/^[0-9+()\-\s]{7,18}$/.test(f.contactNumber))return'Enter a valid contact number.';for(const k of['contractAmount','basic','hra','pf','gratuity','earnedLeave','accidentalInsurance'])if(+f[k]<0)return'Negative values are not allowed.';return''}async function generate(){let v=validate();if(v){setErr(v);return}setBusy(true);setErr("Preparing PDF…");await new Promise(r=>requestAnimationFrame(r));try{const {data:num,error:numError}=await db.rpc('next_appointment_letter_number',{p_letter_date:f.letterDate});if(numError)throw numError;ref.current.querySelectorAll(".lh span:first-child,.annex>div:first-child").forEach(el=>el.textContent=num);setErr("Rendering appointment letter…");const canvas=await html2canvas(ref.current,{scale:1,backgroundColor:"#fff",logging:false,useCORS:false,windowWidth:794,windowHeight:ref.current.scrollHeight});setErr("Creating PDF…");const pdf=new jsPDF("p","mm","a4"),pageW=210,pageH=297,imgW=210,imgH=canvas.height*pageW/canvas.width,img=canvas.toDataURL("image/jpeg",0.82);for(let y=0;y<imgH;y+=pageH){if(y)pdf.addPage();pdf.addImage(img,"JPEG",0,-y,imgW,imgH,undefined,"FAST")}const fileName=num.replaceAll("/","-")+"-"+f.employeeName.replaceAll(" ","-")+".pdf";const pdfData=pdf.output("datauristring").split(",")[1];const safeName=fileName.replace(/[^a-zA-Z0-9._-]/g,"-");const storagePath="neon-db/"+safeName;setErr("Saving letter to Neon…");const values=map(f);values.gross=c.gross;values.total_benefits=c.totalBenefits;values.ctc=c.ctc;const {data:employee,error:employeeError}=await db.from("employee_records").insert(values).select("id").single();if(employeeError)throw employeeError;const {data:letter,error:letterError}=await db.from("appointment_letters").insert({employee_record_id:employee.id,letter_number:num,status:"Generated",generated_at:new Date().toISOString()}).select("id").single();if(letterError)throw letterError;const {error:docError}=await db.from("generated_documents").insert({appointment_letter_id:letter.id,storage_path:storagePath,file_name:safeName,mime_type:"application/pdf",pdf_base64:pdfData});if(docError)throw docError;setResult({number:num,path:"data:application/pdf;base64,"+pdfData,fileName:safeName});setErr("")}catch(e){setErr(e.message||"Generation failed.")}finally{setBusy(false)}}