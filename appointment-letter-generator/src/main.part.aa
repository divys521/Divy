import React,{useEffect,useMemo,useRef,useState} from 'react';
import {createRoot} from 'react-dom/client';
import html2canvas from 'html2canvas';
import {jsPDF} from 'jspdf';
import {FileText,Plus,History,Search,Download,Printer,Eye,CheckCircle,LayoutDashboard} from 'lucide-react';
import './styles.css';
async function api(action,body){const response=await fetch('/api/hr?action='+encodeURIComponent(action),{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined,credentials:'same-origin'});let payload;try{payload=await response.json()}catch{payload={error:'Unexpected server response.'}}if(!response.ok)throw new Error(payload.error||'Request failed ('+response.status+').');return payload;}
const init={employeeName:'',employeeId:'',address:'',contactNumber:'',designation:'',dateOfJoining:'',letterDate:new Date().toISOString().slice(0,10),probationPeriod:'3 months',contractPeriod:'2 years',contractAmount:150000,basic:0,hra:0,pf:1800,gratuity:0,earnedLeave:0,accidentalInsurance:0};
const money=n=>Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2}); const date=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}):'';
function calc(f){let basic=+f.basic||0,hra=+f.hra||0,pf=+f.pf||0,g=+f.gratuity||0,e=+f.earnedLeave||0,a=+f.accidentalInsurance||0;return{gross:basic+hra+pf,totalBenefits:g+e+a,ctc:basic+hra+pf+g+e+a}}
function App(){return <Shell/>}
function Login({onLogin}){const[p,setP]=useState(''),[busy,setBusy]=useState(false),[err,setErr]=useState('');async function submit(e){e.preventDefault();setBusy(true);setErr('');try{await api('login',{password:p});onLogin()}catch(x){setErr(x.message||'Unable to sign in.')}finally{setBusy(false)}}return <div className="login"><form className="login-card" onSubmit={submit}><div className="logo"><FileText/></div><h1>ESS HR Workspace</h1><p>Sign in with your internal HR access password.</p><label>HR Access Password<input type="password" autoComplete="current-password" value={p} onChange={e=>setP(e.target.value)} required autoFocus/></label>{err&&<div className="err">{err}</div>}<button disabled={busy}>{busy?'Signing in…':'Sign in securely'}</button></form></div>}
function Shell(){const[page,setPage]=useState('dash'),[auth,setAuth]=useState('checking');useEffect(()=>{api('me').then(()=>setAuth('yes')).catch(()=>setAuth('no'))},[]);async function logout(){try{await api('logout',{})}catch{}setAuth('no');setPage('dash')}if(auth==='checking')return <div className="app-loading">Loading ESS HR Workspace…</div>;if(auth!=='yes')return <Login onLogin={()=>setAuth('yes')}/>;function go(next){setPage(next)}return <div className="app"><aside><div className="brand"><div className="logo sm"><FileText/></div><b>ESS HR</b></div><nav><button className={page==='dash'?'on':''} onClick={()=>go('dash')}><LayoutDashboard/>Dashboard</button><button className={page==='new'?'on':''} onClick={()=>go('new')}><Plus/>New Appointment Letter</button><button className={page==='hist'?'on':''} onClick={()=>go('hist')}><History/>Appointment Letter History</button></nav></aside><main><header><div><small>HUMAN RESOURCES</small><h2>{page==='dash'?'Dashboard':page==='new'?'New Appointment Letter':'Appointment Letter History'}</h2></div><div className="header-right"><span>ESS HR Workspace · Internal</span><button className="header-auth" onClick={logout}>Sign out</button></div></header>{page==='dash'?<Dashboard go={go}/>:page==='new'?<Generator done={()=>setPage('hist')}/>:<HistoryPage/>}</main></div>}
function Dashboard({go}){const[rows,setRows]=useState([]),[loading,setLoading]=useState(true);useEffect(()=>{let active=true;(async()=>{try{const {data}=await api('list');if(active)setRows(data||[])}catch(e){console.error(e);if(active)setRows([])}finally{if(active)setLoading(false)}})();return()=>{active=false}},[]);return <section className="content"><div className="hero"><div><h3>Appointment Letter Generator</h3><p>Enter employee details once and generate the appointment letter PDF.</p></div><button onClick={()=>go('new')}><Plus/>New Appointment Letter</button></div><div className="stats"><div><small>Total Appointment Letters</small><b>{loading?'…':rows.length}</b></div><div><small>Letters Generated This Month</small><b>{loading?'…':rows.filter(x=>(x.generated_at||'').slice(0,7)===new Date().toISOString().slice(0,7)).length}</b></div><div><small>Drafts</small><b>{loading?'…':rows.filter(x=>x.status==='Draft').length}</b></div></div><section className="panel"><div className="panelhead"><b>Recent Letters</b><button className="link" onClick={()=>go('hist')}>View all</button></div><Table rows={rows.slice(0,5)}/></section></section>}
function Generator({done}){const[f,setF]=useState(init),[preview,setPreview]=useState(false),[busy,setBusy]=useState(false),[err,setErr]=useState(''),[result,setResult]=useState(null),ref=useRef(null),c=useMemo(()=>calc(f),[f]);const set=(k,v)=>setF(x=>({...x,[k]:v}));function validate(){if(!f.employeeName.trim())return'Employee name is required.';if(!f.employeeId.trim())return'Employee ID / Serial Number is required.';if(!f.designation.trim())return'Designation is required.';if(!f.dateOfJoining||!f.letterDate)return'Valid dates are required.';if(f.contactNumber&&!/^[0-9+()\-\s]{7,18}$/.test(f.contactNumber))return'Enter a valid contact number.';for(const k of['contractAmount','basic','hra','pf','gratuity','earnedLeave','accidentalInsurance'])if(+f[k]<0)return'Negative values are not allowed.';return''}async function generate(){let stage='Validating employee details';let v=validate();if(v){setErr(v);return}setBusy(true);setErr("Preparing PDF…");await new Promise(r=>requestAnimationFrame(r));try{stage='Assigning letter number';const {number:num}=await api('next-number',{letter_date:f.letterDate});if(typeof num!=='string'||!num.trim())throw new Error('The server did not return a valid appointment letter number.');ref.current.querySelectorAll(".lh span:first-child,.annex>div:first-child").forEach(el=>el.textContent=num);stage='Preparing appointment letter pages';setErr("Rendering appointment letter…");const pages=[...ref.current.querySelectorAll(".pdf-page")];if(pages.length!==3)throw new Error("The print template must contain exactly 3 A4 pages.");stage='Creating PDF document';setErr("Rendering print-ready pages…");const pdf=new jsPDF("p","mm","a4");for(let i=0;i<pages.length;i++){stage=`Rendering PDF page ${i+1} of ${pages.length}`;const canvas=await html2canvas(pages[i],{scale:2,backgroundColor:"#fff",logging:false,useCORS:false,windowWidth:794,windowHeight:1123});if(i)pdf.addPage();pdf.addImage(canvas.toDataURL("image/jpeg",0.94),"JPEG",0,0,210,297,undefined,"FAST")}stage='Finalizing PDF file';setErr("Creating PDF…");const fileName=num.replaceAll("/","-")+"-"+f.employeeName.replaceAll(" ","-")+".pdf";const pdfBlob=pdf.output("blob");const pdfUrl=URL.createObjectURL(pdfBlob);const pdfData=pdf.output("datauristring").split(",")[1];const safeName=fileName.replace(/[^a-zA-Z0-9._-]/g,"-");setResult({number:num,path:pdfUrl,fileName:safeName,blob:pdfBlob});setErr("PDF created. Saving a copy to the history…");stage='Saving employee record and PDF to protected history';const values=map(f);values.gross=c.gross;values.total_benefits=c.totalBenefits;values.ctc=c.ctc;await api('save',{employee:values,letter_number:num,file_name:safeName,pdf_base64:pdfData});setErr("")}catch(e){console.error("Appointment PDF generation failed at: "+stage,e);setErr(stage+": "+(e?.message||String(e)||"Generation failed."))}finally{setBusy(false)}}