age.from('appointment-letters').upload(path,blob,{contentType:'application/pdf',upsert:true});if(e4)throw e4;const{error:e5}=await sb.from('generated_documents').insert({created_by:uid,appointment_letter_id:letter.id,storage_path:path,file_name:num.replaceAll('/','-')+'-'+f.employeeName.replaceAll(' ','-')+'.pdf'});if(e5)throw e5;setResult({number:num,path});}catch(e){setErr(e.message||'Generation failed.')}finally{setBusy(false)}}if(result)return <section className="content"><div className="success"><CheckCircle/><h3>Appointment Letter Generated Successfully</h3><p>{result.number}</p><div><DocButton icon={<Eye/>} text="View PDF" path={result.path}/><DocButton icon={<Download/>} text="Download PDF" path={result.path} download/><DocButton icon={<Printer/>} text="Print" path={result.path}/></div><button className="link" onClick={done}>Go to Appointment Letter History</button></div></section>;return <section className="content">{!preview?<><Form f={f} set={set} c={c}/><div className="actions"><span>Required fields are marked *</span><button onClick={()=>{let v=validate();if(v)setErr(v);else{setErr('');setPreview(true)}}}>Preview Appointment Letter</button></div></>:<><div className="previewbar"><div><h3>Appointment Letter Preview</h3><span>Review the complete letter before generation.</span></div><div><button className="secondary" onClick={()=>setPreview(false)}>Edit Details</button><button onClick={generate} disabled={busy}>{busy?'Generating…':'Generate PDF'}</button></div></div><div className="paper"><div ref={ref}><Letter f={f} c={c} number="PREVIEW — NUMBER ASSIGNED ON GENERATION"/></div></div></>}{err&&<div className="err bottom">{err}</div>}</section>}
function map(f){return{employee_name:f.employeeName,employee_id:f.employeeId,address:f.address,contact_number:f.contactNumber,designation:f.designation,date_of_joining:f.dateOfJoining,letter_date:f.letterDate,probation_period:f.probationPeriod,contract_period:f.contractPeriod,contract_amount:+f.contractAmount||0,basic:+f.basic||0,hra:+f.hra||0,pf:+f.pf||0,gratuity:+f.gratuity||0,earned_leave:+f.earnedLeave||0,accidental_insurance:+f.accidentalInsurance||0}}
function Form({f,set,c}){return <div className="formgrid"><Section title="A — Employee Details"><Field n="Employee Name" k="employeeName" f={f} set={set} req/><Field n="Employee ID / Serial Number" k="employeeId" f={f} set={set} req/><Field n="Address" k="address" f={f} set={set} area/><Field n="Contact Number" k="contactNumber" f={f} set={set}/><Field n="Designation" k="designation" f={f} set={set} req/><Field n="Date of Joining" k="dateOfJoining" f={f} set={set} type="date" req/><Field n="Letter Date" k="letterDate" f={f} set={set} type="date" req/></Section><Section title="B — Employment Details"><Field n="Probation / Training Period" k="probationPeriod" f={f} set={set}/><Field n="Contract Period" k="contractPeriod" f={f} set={set}/><Field n="Contract Amount" k="contractAmount" f={f} set={set} type="number"/></Section><Section title="C — Salary Details"><Field n="Basic" k="basic" f={f} set={set} type="number"/><Field n="HRA" k="hra" f={f} set={set} type="number"/><Field n="PF" k="pf" f={f} set={set} type="number"/><Readonly n="Gross" v={money(c.gross)}/></Section><Section title="D — Benefits"><Field n="Gratuity" k="gratuity" f={f} set={set} type="number"/><Field n="Earned Leave" k="earnedLeave" f={f} set={set} type="number"/><Field n="Personal Accidental Insurance" k="accidentalInsurance" f={f} set={set} type="number"/><Readonly n="Total Benefits" v={money(c.totalBenefits)}/><Readonly n="CTC" v={money(c.ctc)}/></Section></div>}
function Section({title,children}){return <section className="panel section"><div className="panelhead"><b>{title}</b></div><div className="fields">{children}</div></section>};function Field({n,k,f,set,type='text',area,req}){return <label>{n}{req&&<i>*</i>}{area?<textarea value={f[k]} onChange={e=>set(k,e.target.value)}/>:<input type={type} min={type==='number'?0:undefined} value={f[k]} onChange={e=>set(k,e.target.value)}/>}</label>};function Readonly({n,v}){return <label>{n}<div className="readonly">{v}</div></label>}
function Letter({f,c,number}){return <div className="letter"><div className="lh"><span>{number}</span><span>{date(f.letterDate)} Appointment Letter</span></div><p><b>Mr. {f.employeeName}</b><br/>{f.address}</p><p>Dear {f.employeeName.split(' ')[0]||f.employeeName},</p><p>We are pleased to appoint you as <b>{f.designation}</b> at Eastern Software Solutions Pvt. Ltd. with effect from {date(f.dateOfJoining)}. The following are the terms and conditions of the employment:</p><Clause n="1" t="COMPENSATION & BENEFITS">Please refer to Annexure A for the details as applicable to you.</Clause><Clause n="2" t="LEAVE AND LEAVE ENCASHMENT">You will be entitled to leave and leave encashment in accordance with and subject to the company's rules.</Clause><Clause n="3" t="PERSONAL ACCIDENT INSURANCE">You would be provided an accidental insurance coverage of Rs.100000/-.</Clause><Clause n="4" t="GUEST HOUSE FACILITY">As per the rules of the company and subject to the discretion of the management, shared guest house facility could be provided to you outside your city of joining. (Applicable for Bachelors Only)</Clause><Clause n="5" t="SERVICE CONTRACT">You are required to execute a service contract, as per the rules and regulations of the company, at the time of joining the Company. As per the service contract, you are required to work with ESS for a minimum period of {f.contractPeriod||'2 years'}, otherwise you are required to pay Rs. {money(f.contractAmount)}/- to partially cover the cost of training imparted to you or the time/money invested on you.</Clause><Clause n="6" t="PROBATION/ CONFIRMATION">You shall be on probation for a period of {f.probationPeriod||'3 months'} during which, you will be working as a trainee. Training which will be imparted to you could be either classroom training or on-the-job training. The training period could be extended beyond {f.probationPeriod||'3 months'} at the discretion of the management. On successful completion of training period, you will be confirmed by express communication, or could be deemed as a trainee even after completion of your training period or extended training period.</Clause><Accept/><Clause n="7" t="NOTICE PERIOD">From either side, during the first 30 days of employment, duration of notice period will be 7 days. From 31st day till confirmation, duration of notice period will be 30 days. After confirmation, the duration of notice period will be 90 days. No relaxation in the notice period shall be permitted.</Clause><Clause n="8" t="TRANSFERABILITY">In the Company’s interest, you may be transferred at any time from one job, section or department to another, and from one establishment/office to any other establishment/office of the Company or from one city to another city in India or outside India, on the salary you draw at the time of your transfer or revised salary as per the rules and regulations of the Company. “However your appointment will be deemed to have been made in the Head Office at Noida”.</Clause><Clause n="9" t="OTHER BUSINESS INTERESTS OR EMPLOYMENT">You shall during your services with the Company, work to the best of your ability and devote your full time to the Company's business as directed by the Company. As long as you are employed by the Company, you shall not have interests or be employed at any time either directly or indirectly in any other business except with the prior consent in writing of the management. You will also be required to sign a confidentiality/Non-disclosure agreement at the time of joining to protect company/company associates/clients confidential information. You are also prohibited from joining company’s clients for 36 months after your separation.</Clause><Clause n="10" t="COMPANY RULES AND REGULATIONS">In addition to the terms defined in this letter, your employment will be subject to the Rules and Regulations of the Company (subject to change from time to time). These Rules and Regulations, the current version of which you have signed as your acceptance of the same, form an essential and integral part of your employment terms and conditions.</Clause><Clause n="11" t="ACCEPTANCE">Please sign and return the duplicate copy of this letter confirming your acceptance of the appointment and the conditions of service specified in this letter. We are excited about the talent you will bring to our company and look forward to your many contributions.</Clause><Sign/><div className="break"/><div className="annex"><div>{number}</div><div>{date(f.letterDate)} Confidential</div><h4>{f.employeeName}</h4><div>{f.designation}</div><h2>Annexure A</h2><table><thead><tr><th>Earnings</th><th>Monthly</th><th>Annual</th></tr></thead><tbody><R n="BASIC" v={f.basic}/><R n="HRA" v={f.hra}/><R n="PF" v={f.pf}/><R n="GROSS(A)" v={c.gross} b/></tbody><thead><tr><th>Benefits</th><th>Monthly</th><th>Annual</th></tr></thead><tbody><R n="Gratuity (Eligible after 5 years of service)" v={f.gratuity}/><R n="Earned Leaves (1.25 days per month. EL can be accumulated, but such accumulation should not exceed 45 days. EL is encashable only at the time of separation.)" v={f.earnedLeave}/><R n="Personal Accidental Insurance (Up to Rupees 100000 )" v={f.accidentalInsurance}/><R n="Total Benefits (B)" v={c.totalBenefits} b/><R n="CTC (A+B)" v={c.ctc} b/></tbody></table><Sign/></div></div>}