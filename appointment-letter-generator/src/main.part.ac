function Clause({n,t,children}){return <div className="clause"><b>{n}. {t}:</b><p>{children}</p></div>}function Accept(){return <div className="accept">…………………………………………………………………………………………………………<p>I hereby accept the appointment on the terms and conditions of employment set out in this letter and by my signature hereto I bind myself to abide by these.</p>Name: …………………………...........................<br/>Signature: ………………………........................<br/>Date: ……………………………........................</div>}function Sign(){return <div className="sign"><p>For Eastern Software Solutions Pvt. Ltd.</p><b>Dishant Chhabra</b><br/>Manager - Human Resources<Accept/></div>}function R({n,v,b}){return <tr className={b?'bold':''}><td>{n}</td><td>{money(v)}</td><td>{money((+v||0)*12)}</td></tr>}
function HistoryPage(){const[rows,setRows]=useState([]),[q,setQ]=useState('');async function load(){let r=await sb.from('appointment_letters').select('id,letter_number,status,generated_at,employee_records(employee_name,employee_id,designation,date_of_joining,letter_date)').order('generated_at',{ascending:false});setRows(r.data||[])}useEffect(()=>{load()},[]);const f=rows.filter(x=>[x.letter_number,x.employee_records?.employee_name,x.employee_records?.employee_id,x.employee_records?.designation].join(' ').toLowerCase().includes(q.toLowerCase()));return <section className="content"><section className="panel"><div className="search"><Search/><input placeholder="Search employee, ID, designation or letter number" value={q} onChange={e=>setQ(e.target.value)}/></div><Table rows={f}/></section></section>}
function Table({rows}){return <div className="tablewrap"><table><thead><tr><th>Employee Name</th><th>Employee ID</th><th>Designation</th><th>Date of Joining</th><th>Letter Number</th><th>Letter Date</th><th>Generated Date</th><th>Status</th><th>Action</th></tr></thead><tbody>{rows.map(x=><tr key={x.id}><td><b>{x.employee_records?.employee_name}</b></td><td>{x.employee_records?.employee_id}</td><td>{x.employee_records?.designation}</td><td>{date(x.employee_records?.date_of_joining)}</td><td>{x.letter_number}</td><td>{date(x.employee_records?.letter_date)}</td><td>{x.generated_at?new Date(x.generated_at).toLocaleDateString('en-IN'):''}</td><td><em>{x.status}</em></td><td><button className="icon" onClick={()=>openDoc(x)}><Eye/></button><button className="icon" onClick={()=>downloadDoc(x)}><Download/></button></td></tr>)}</tbody></table></div>}
async function openDoc(x){const{data}=await sb.from('generated_documents').select('storage_path').eq('appointment_letter_id',x.id).single();if(data){const{data:s}=await sb.storage.from('appointment-letters').createSignedUrl(data.storage_path,3600);if(s?.signedUrl)window.open(s.signedUrl,'_blank')}}async function downloadDoc(x){const{data}=await sb.from('generated_documents').select('storage_path,file_name').eq('appointment_letter_id',x.id).single();if(data){const{data:b}=await sb.storage.from('appointment-letters').download(data.storage_path);const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=data.file_name;a.click();URL.revokeObjectURL(u)}}function DocButton({icon,text,path,download}){return <button onClick={async()=>{const{data}=await sb.storage.from('appointment-letters').createSignedUrl(path,3600);if(data?.signedUrl){if(download){const b=await sb.storage.from('appointment-letters').download(path);const u=URL.createObjectURL(b.data),a=document.createElement('a');a.href=u;a.download='appointment-letter.pdf';a.click();URL.revokeObjectURL(u)}else window.open(data.signedUrl,'_blank')}}}>{icon}{text}</button>}
